{
  "name": "fieldnote-skills",
  "version": "0.1.0",
  "description": "Your coding agent writes the code. These skills run the loop around it: settled design to ticketed PRD, every takeable issue as one parallel wave of worktrees and pull requests, evidence-filled PRs, and a drained review board.",
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "git+https://github.com/dervalp/fieldnote-skills.git" },
  "type": "module",
  "bin": { "fieldnote-skills": "cli/dist/index.js" },
  "files": [
    "cli/dist",
    "cli/skills",
    "cli/catalog.json",
    "cli/release.json",
    "cli/skills.lock.json",
    "cli/package.json"
  ],
  "engines": { "node": ">=21" },
  "scripts": {
    "catalog": "node --import tsx cli/scripts/build-catalog.ts",
    "validate": "node --import tsx cli/scripts/validate.ts",
    "vendor": "node --import tsx cli/scripts/vendor.ts",
    "release": "node --import tsx cli/scripts/release.ts",
    "package": "node --import tsx cli/scripts/package.ts",
    "check:decoupling": "node --import tsx cli/scripts/check-decoupling.ts",
    "prepare": "tsc -p cli/tsconfig.json && node --import tsx cli/scripts/bundle.ts"
  },
  "dependencies": { "@inquirer/prompts": "^7.2.0", "chalk": "^5.3.0" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fflate": "^0.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
